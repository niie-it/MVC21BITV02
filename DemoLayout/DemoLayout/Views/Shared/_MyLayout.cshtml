<!DOCTYPE html>

<html>
<head>
	<meta name="viewport" content="width=device-width" />
	<title>@ViewBag.Title</title>
	<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
	@RenderSection("Styles", required: false)
	<style>
		#myheader{height: 100px; background-color: cyan;}
		#myfooter{border: 1px solid red; text-align:center;}
		.min-height-400{min-height:400px;}
	</style>
</head>
<body>
	<div class="container">
		<div id="myheader">#HEADER</div>
		<div class="row m-0">
			<aside class="col-3 min-height-400 bg-gradient">#MENU</aside>
			<div class="col-9 min-height-400 bg-light">
				@RenderBody()
			</div>
		</div>
		<div id="myfooter">&copy; ABC 2024</div>
	</div>
	<script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
	<script src="~/lib/jquery/dist/jquery.js"></script>
	@RenderSection("Scripts", required: false)
</body>
</html>
