@model List<Lab07.Models.ProductBySupplierVM>
@{
	ViewData["Title"] = "GetProductBySuppliers";
}

<h1>Product By Suppliers</h1>
<table class="table table-hover">
	@foreach (var item in Model)
	{
		<tr>
			<td>@item.ProductId</td>
			<td>@item.ProductName</td>
			<td>@item.UnitPrice</td>
			<td>@item.Category</td>
			<td>@item.Status</td>
		</tr>
	}
</table>

